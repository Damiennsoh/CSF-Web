"use client"

import type React from "react"
import { useEffect, useState } from "react"
import { db } from "@/lib/firebase"
import { 
  collection, 
  getDocs, 
  doc, 
  updateDoc, 
  deleteDoc, 
  query, 
  orderBy, 
  limit, 
  where,
  getCountFromServer,
  addDoc,
  serverTimestamp
} from "firebase/firestore"
import { useRouter } from "next/navigation"
import { useAuth } from "@/contexts/auth-context"
import { toast } from "@/hooks/use-toast"
import { logAdminAction } from "@/lib/admin-logger"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Textarea } from "@/components/ui/textarea"
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { Users, Calendar, MessageSquare, DollarSign, Plus, Edit, Trash2, Shield, AlertTriangle, Crown, Info, ImageIcon, FileText, GraduationCap, Star, Heart } from 'lucide-react'
import Link from "next/link"
import { BackButton } from "@/components/back-button"
import { AdminGuard } from "@/components/admin-guard" // Import AdminGuard

interface UserWithAdminInfo {
  id: string
  email: string
  fullName: string
  isAdmin: boolean
  createdAt: string
  is_first_user?: boolean
}

export default function AdminDashboard() {
  const { user, isAdmin, loading: authLoading, adminStatusConfirmed, adminCheckInProgress } = useAuth()
  const [stats, setStats] = useState({
    totalUsers: 0,
    totalEvents: 0,
    totalPrayerRequests: 0,
    totalDonations: 0,
    recentMessages: 0,
  })
  const [loading, setLoading] = useState(true)
  const router = useRouter()
  const [users, setUsers] = useState<UserWithAdminInfo[]>([])
  const [firstUser, setFirstUser] = useState<UserWithAdminInfo | null>(null)
  const [ministries, setMinistries] = useState<any[]>([])
  const [ministryRoles, setMinistryRoles] = useState<any[]>([])
  const [selectedMinistry, setSelectedMinistry] = useState<string>("")
  const [resources, setResources] = useState<any[]>([])
  const [messages, setMessages] = useState<any[]>([])
  const [events, setEvents] = useState<any[]>([])
  const [auditLogs, setAuditLogs] = useState<any[]>([])

  // Form states
  const [isAddingRole, setIsAddingRole] = useState(false)
  const [isEditingRole, setIsEditingRole] = useState(false)
  const [currentRole, setCurrentRole] = useState<any>(null)

  useEffect(() => {
    if (authLoading || adminCheckInProgress || !adminStatusConfirmed) {
      return
    }

    if (!authLoading) {
      if (!user) {
        router.push("/auth/login")
        return
      }

      if (!isAdmin) {
        toast({
          title: "Access Denied",
          description: "You don't have permission to access the admin dashboard.",
          variant: "destructive",
        })
        router.push("/")
        return
      }

      loadDashboardData()
    }
  }, [user, isAdmin, authLoading, adminStatusConfirmed, adminCheckInProgress, router])

  const loadDashboardData = async () => {
    setLoading(true)
    await Promise.all([
      loadStats(),
      loadUsers(),
      loadMinistries(),
      loadResources(),
      loadMessages(),
      loadEvents(),
      loadAuditLogs()
    ])
    setLoading(false)
  }

  const loadAuditLogs = async () => {
    try {
      const q = query(collection(db, "admin_audit_logs"), orderBy("timestamp", "desc"), limit(50))
      const querySnapshot = await getDocs(q)
      const list: any[] = []
      querySnapshot.forEach(doc => list.push({ id: doc.id, ...doc.data() }))
      setAuditLogs(list)
    } catch (error) {
      console.error("Error loading audit logs:", error)
    }
  }

  const loadStats = async () => {
    try {
      const usersCol = collection(db, "users")
      const eventsCol = collection(db, "events")
      const prayersCol = collection(db, "prayer_requests")
      const donationsCol = collection(db, "donations")
      const messagesCol = collection(db, "contact_messages")
      const unreadMessagesQuery = query(messagesCol, where("isRead", "==", false))

      const [
        usersSnap,
        eventsSnap,
        prayersSnap,
        donationsSnap,
        messagesSnap
      ] = await Promise.all([
        getCountFromServer(usersCol),
        getCountFromServer(eventsCol),
        getCountFromServer(prayersCol),
        getCountFromServer(donationsCol),
        getCountFromServer(unreadMessagesQuery)
      ])

      setStats({
        totalUsers: usersSnap.data().count,
        totalEvents: eventsSnap.data().count,
        totalPrayerRequests: prayersSnap.data().count,
        totalDonations: donationsSnap.data().count,
        recentMessages: messagesSnap.data().count,
      })
    } catch (error) {
      console.error("Error loading stats:", error)
    } finally {
      setLoading(false); // Ensure loading is set to false after stats load
    }
  }

  const loadUsers = async () => {
    try {
      const q = query(collection(db, "users"), orderBy("createdAt", "asc"))
      const querySnapshot = await getDocs(q)
      
      const usersList: UserWithAdminInfo[] = []
      querySnapshot.forEach((doc) => {
        usersList.push({ id: doc.id, ...doc.data() } as UserWithAdminInfo)
      })

      const usersWithFirstUserFlag = usersList.map((u, index) => ({
        ...u,
        is_first_user: index === 0
      }))

      setUsers(usersWithFirstUserFlag)
      if (usersWithFirstUserFlag.length > 0) {
        setFirstUser(usersWithFirstUserFlag[0])
      }
    } catch (error) {
      console.error("Error loading users:", error)
    }
  }

  const loadMinistries = async () => {
    try {
      const q = query(collection(db, "ministries"), orderBy("name", "asc"))
      const querySnapshot = await getDocs(q)
      const list: any[] = []
      querySnapshot.forEach(doc => list.push({ id: doc.id, ...doc.data() }))
      setMinistries(list)
    } catch (error) {
      console.error("Error loading ministries:", error)
    }
  }

  const loadMinistryRoles = async (ministryId: string) => {
    try {
      const q = query(
        collection(db, "ministry_roles"), 
        where("ministryId", "==", ministryId),
        orderBy("displayOrder", "asc")
      )
      const querySnapshot = await getDocs(q)
      const list: any[] = []
      querySnapshot.forEach(doc => list.push({ id: doc.id, ...doc.data() }))
      setMinistryRoles(list)
    } catch (error) {
      console.error("Error loading ministry roles:", error)
    }
  }

  const loadResources = async () => {
    try {
      const q = query(collection(db, "ministry_resources"), orderBy("createdAt", "desc"), limit(10))
      const querySnapshot = await getDocs(q)
      const list: any[] = []
      querySnapshot.forEach(doc => list.push({ id: doc.id, ...doc.data() }))
      setResources(list)
    } catch (error) {
      console.error("Error loading resources:", error)
    }
  }

  const loadMessages = async () => {
    try {
      const q = query(collection(db, "contact_messages"), orderBy("createdAt", "desc"), limit(10))
      const querySnapshot = await getDocs(q)
      const list: any[] = []
      querySnapshot.forEach(doc => list.push({ id: doc.id, ...doc.data() }))
      setMessages(list)
    } catch (error) {
      console.error("Error loading messages:", error)
    }
  }

  const loadEvents = async () => {
    try {
      const q = query(collection(db, "events"), orderBy("eventDate", "asc"), limit(10))
      const querySnapshot = await getDocs(q)
      const list: any[] = []
      querySnapshot.forEach(doc => list.push({ id: doc.id, ...doc.data() }))
      setEvents(list)
    } catch (error) {
      console.error("Error loading events:", error)
    }
  }

  const toggleAdmin = async (userId: string, currentAdminStatus: boolean, isFirstUser: boolean) => {
    if (isFirstUser && currentAdminStatus) {
      toast({
        title: "Cannot Remove Admin",
        description: "The first user must remain an administrator for system security.",
        variant: "destructive",
      })
      return
    }

    try {
      await updateDoc(doc(db, "users", userId), {
        isAdmin: !currentAdminStatus
      })

      // Log action
      if (user) {
        await logAdminAction(
          user.uid,
          user.email || "Unknown",
          "UPDATE_USER_ROLE",
          `${currentAdminStatus ? "Revoked" : "Granted"} admin status to ${userId}`,
          userId
        )
      }

      await loadUsers()
      toast({
        title: "User Updated",
        description: `Admin status ${currentAdminStatus ? "removed" : "granted"} successfully.`,
      })
    } catch (error) {
      console.error("Error updating admin status:", error)
      toast({
        title: "Error",
        description: "Failed to update admin status.",
        variant: "destructive",
      })
    }
  }

  const handleAddRole = async (e: React.FormEvent) => {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    const formData = new FormData(form)

    try {
      await addDoc(collection(db, "ministry_roles"), {
        ministryId: selectedMinistry,
        roleName: formData.get("role_name"),
        personName: formData.get("person_name"),
        personEmail: formData.get("person_email"),
        bio: formData.get("bio"),
        displayOrder: Number.parseInt(formData.get("display_order") as string) || 0,
        isCurrent: true,
        createdAt: serverTimestamp()
      })

      loadMinistryRoles(selectedMinistry)
      setIsAddingRole(false)
      toast({
        title: "Role added",
        description: "New ministry role has been added successfully.",
      })
    } catch (error) {
      console.error("Error adding role:", error)
      toast({
        title: "Error",
        description: "Failed to add ministry role.",
        variant: "destructive",
      })
    }
  }

  const handleEditRole = async (e: React.FormEvent) => {
    e.preventDefault()
    const form = e.target as HTMLFormElement
    const formData = new FormData(form)

    try {
      await updateDoc(doc(db, "ministry_roles", currentRole.id), {
        roleName: formData.get("role_name"),
        personName: formData.get("person_name"),
        personEmail: formData.get("person_email"),
        bio: formData.get("bio"),
        displayOrder: Number.parseInt(formData.get("display_order") as string) || 0,
        updatedAt: serverTimestamp()
      })

      loadMinistryRoles(selectedMinistry)
      setIsEditingRole(false)
      setCurrentRole(null)
      toast({
        title: "Role updated",
        description: "Ministry role has been updated successfully.",
      })
    } catch (error) {
      console.error("Error updating role:", error)
      toast({
        title: "Error",
        description: "Failed to update ministry role.",
        variant: "destructive",
      })
    }
  }

  const handleDeleteRole = async (roleId: string) => {
    try {
      await deleteDoc(doc(db, "ministry_roles", roleId))
      loadMinistryRoles(selectedMinistry)
      toast({
        title: "Role deleted",
        description: "Ministry role has been deleted successfully.",
      })
    } catch (error) {
      console.error("Error deleting role:", error)
      toast({
        title: "Error",
        description: "Failed to delete ministry role.",
      })
    }
  }

  if (authLoading || loading) {
    return (
      <div className="flex-1 flex items-center justify-center bg-background">
        <div className="text-center">
          <div className="animate-spin rounded-full h-32 w-32 border-b-2 border-red-600 mx-auto"></div>
          <p className="mt-4 text-gray-600">Loading admin dashboard...</p>
        </div>
      </div>
    )
  }

  if (!isAdmin) {
    return (
      <div className="flex-1 flex items-center justify-center bg-background">
        <div className="text-center max-w-md mx-auto p-6">
          <AlertTriangle className="h-16 w-16 text-red-500 mx-auto mb-4" />
          <h1 className="text-2xl font-bold text-gray-900 mb-2">Access Denied</h1>
          <p className="text-gray-600 mb-6">You don't have permission to access the admin dashboard.</p>
          <Link href="/">
            <Button>Return to Home</Button>
          </Link>
        </div>
      </div>
    )
  }

  return (
    <div className="flex-1 bg-background py-4 sm:py-8 mb-20 lg:mb-0">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <BackButton showHomeButton={true} customText="Back to Site" />

        <div className="mb-6 sm:mb-8">
          <div className="flex items-center gap-3 mb-2">
            <Shield className="h-8 w-8 text-red-600" />
            <h1 className="text-2xl sm:text-3xl font-bold text-gray-900">Admin Dashboard</h1>
          </div>
          <p className="text-sm sm:text-base text-gray-600">Manage your Christian Students Fellowship website</p>
          <div className="mt-2 flex flex-wrap gap-2">
            <Badge variant="destructive" className="text-xs">
              Administrator Access
            </Badge>
            {firstUser && user?.uid === firstUser.id && (
              <Badge variant="outline" className="text-xs border-yellow-500 text-yellow-700">
                <Crown className="h-3 w-3 mr-1" />
                First Admin
              </Badge>
            )}
          </div>
          </div>
        </div>

        {firstUser && (
          <Alert className="mb-6 border-blue-500 bg-blue-50">
            <Info className="h-4 w-4 text-blue-600" />
            <AlertDescription className="text-blue-800 text-xs sm:text-sm">
              <strong>First Administrator:</strong> {firstUser.fullName || firstUser.email} (registered{" "}
              {new Date(firstUser.createdAt).toLocaleDateString()}) has permanent admin privileges.
            </AlertDescription>
          </Alert>
        )}

        <div className="grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-6 mb-6 sm:mb-8">
          {[
            { label: "Users", count: stats.totalUsers, icon: Users },
            { label: "Events", count: stats.totalEvents, icon: Calendar },
            { label: "Prayers", count: stats.totalPrayerRequests, icon: MessageSquare },
            { label: "Messages", count: stats.recentMessages, icon: MessageSquare },
            { label: "Donations", count: `₹${stats.totalDonations}`, icon: DollarSign, link: "/admin/donations" },
          ].map((stat, i) => (
            <Card key={i} className="col-span-1">
              <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                <CardTitle className="text-[10px] sm:text-xs font-medium uppercase tracking-wider text-gray-500">{stat.label}</CardTitle>
                <stat.icon className="h-4 w-4 text-muted-foreground" />
              </CardHeader>
              <CardContent>
                <div className="text-lg sm:text-2xl font-bold">{stat.count}</div>
                {stat.link && (
                  <Link href={stat.link}>
                    <Button variant="link" className="p-0 h-auto text-[10px] sm:text-xs text-red-600">
                      Manage
                    </Button>
                  </Link>
                )}
              </CardContent>
            </Card>
          ))}
        </div>

        <div className="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-6 sm:mb-8">
          {[
            { label: "Donations", sub: "Manage giving", icon: DollarSign, color: "text-green-600", href: "/admin/donations" },
            { label: "Profiles", sub: "Manage leaders", icon: Users, color: "text-blue-600", href: "/admin/profile-management" },
            { label: "Events", sub: "Manage events", icon: Calendar, color: "text-purple-600", href: "/admin/events" },
            { label: "Gallery", sub: "Manage photos", icon: ImageIcon, color: "text-pink-600", href: "/admin/gallery" },
            { label: "Resources", sub: "Manage files", icon: FileText, color: "text-indigo-600", href: "/admin/resources" },
            { label: "Alumni", sub: "Manage alumni", icon: GraduationCap, color: "text-orange-600", href: "/admin/alumni" },
            { label: "Testimonials", sub: "Manage reviews", icon: Star, color: "text-yellow-600", href: "/admin/testimonials" },
            { label: "Prayers", sub: "View & respond", icon: Heart, color: "text-red-600", href: "/admin/prayer-requests" },
          ].map((action, i) => (
            <Link key={i} href={action.href}>
              <Card className="hover:shadow-md transition-shadow cursor-pointer h-full">
                <CardContent className="p-3 sm:p-6 flex flex-col items-center text-center sm:flex-row sm:items-center sm:text-left sm:space-x-4">
                  <action.icon className={`h-8 w-8 ${action.color} mb-2 sm:mb-0`} />
                  <div>
                    <h3 className="font-semibold text-xs sm:text-base">{action.label}</h3>
                    <p className="hidden sm:block text-xs text-gray-600">{action.sub}</p>
                  </div>
                </CardContent>
              </Card>
            </Link>
          ))}
        </div>

        <Tabs defaultValue="users" className="space-y-6">
          <TabsList className="flex flex-nowrap overflow-x-auto w-full h-auto bg-transparent border-b gap-2 pb-2 mb-4 scrollbar-hide">
            {["Users", "Ministries", "Resources", "Messages", "Events", "Donations", "Logs"].map((tab) => (
              <TabsTrigger 
                key={tab} 
                value={tab.toLowerCase()} 
                className="px-4 py-2 text-xs sm:text-sm whitespace-nowrap border rounded-full data-[state=active]:bg-red-600 data-[state=active]:text-white"
              >
                {tab}
              </TabsTrigger>
            ))}
          </TabsList>

          <TabsContent value="users">
            <Card>
              <CardHeader>
                <CardTitle className="text-lg sm:text-xl">User Management</CardTitle>
                <CardDescription className="text-xs sm:text-sm">
                  Manage user accounts and admin privileges.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-3">
                  {users.map((userItem) => (
                    <div
                      key={userItem.id}
                      className={`flex flex-col sm:flex-row sm:items-center justify-between p-3 border rounded-lg gap-3 ${
                        userItem.is_first_user ? "border-yellow-300 bg-yellow-50" : ""
                      }`}
                    >
                      <div className="flex-1">
                        <div className="flex items-center gap-2 mb-1">
                          <h3 className="font-semibold text-sm sm:text-base">{userItem.fullName || userItem.email}</h3>
                          {userItem.is_first_user && <Crown className="h-4 w-4 text-yellow-600" />}
                        </div>
                        <p className="text-[10px] sm:text-xs text-gray-600">{userItem.email}</p>
                      </div>
                      <div className="flex items-center gap-2 justify-between sm:justify-end">
                        {userItem.isAdmin && (
                          <Badge variant={userItem.is_first_user ? "default" : "secondary"} className="text-[10px]">
                            {userItem.is_first_user ? "Permanent Admin" : "Admin"}
                          </Badge>
                        )}
                        <Button
                          variant={userItem.isAdmin ? "destructive" : "default"}
                          size="sm"
                          onClick={() => toggleAdmin(userItem.id, userItem.isAdmin, userItem.is_first_user || false)}
                          disabled={userItem.is_first_user && userItem.isAdmin}
                          className="text-[10px] h-8"
                        >
                          {userItem.isAdmin ? "Remove Admin" : "Make Admin"}
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
            <Link href="/admin/profile-management">
              <Card className="hover:shadow-md transition-shadow cursor-pointer">
                <CardContent className="p-4 sm:p-6">
                  <div className="flex items-center space-x-3">
                    <Users className="h-8 w-8 text-blue-600" />
                    <div>
                      <h3 className="font-semibold text-sm sm:text-base">Profiles</h3>
                      <p className="text-xs sm:text-sm text-gray-600">Manage leaders</p>
                    </div>
                  </div>
                </CardContent>
              </Card>
            </Link>
            <Card className="hover:shadow-md transition-shadow cursor-pointer">
              <CardContent className="p-4 sm:p-6">
                <div className="flex items-center space-x-3">
                  <Calendar className="h-8 w-8 text-purple-600" />
                  <div>
                    <h3 className="font-semibold text-sm sm:text-base">Events</h3>
                    <p className="text-xs sm:text-sm text-gray-600">Manage events</p>
                  </div>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          {/* Ministry tab updated for Firestore */}
          <TabsContent value="ministries">
            <Card>
              <CardHeader>
                <CardTitle className="text-lg sm:text-xl">Ministry Management</CardTitle>
                <CardDescription className="text-xs sm:text-sm">Manage ministry roles and leadership</CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-4">
                  <div>
                    <Label htmlFor="ministry-select" className="text-sm">Select Ministry</Label>
                    <Select
                      value={selectedMinistry}
                      onValueChange={(value) => {
                        setSelectedMinistry(value)
                        loadMinistryRoles(value)
                      }}
                    >
                      <SelectTrigger>
                        <SelectValue placeholder="Choose a ministry" />
                      </SelectTrigger>
                      <SelectContent>
                        {ministries.map((ministry) => (
                          <SelectItem key={ministry.id} value={ministry.id}>{ministry.name}</SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </div>
                </div>
              </CardContent>
            </Card>

                  {selectedMinistry && (
                    <div className="space-y-4">
                      <div className="flex justify-between items-center">
                        <h3 className="text-sm sm:text-base font-semibold">Roles</h3>
                        <Button size="sm" onClick={() => setIsAddingRole(true)} className="h-8 text-xs">
                          <Plus className="h-3 w-3 mr-1" /> Add Role
                        </Button>
                      </div>
                      <div className="space-y-2">
                        {ministryRoles.map((role) => (
                          <div key={role.id} className="flex flex-col sm:flex-row sm:items-center justify-between p-3 border rounded gap-3">
                            <div className="flex-1">
                              <h4 className="font-medium text-xs sm:text-sm">{role.roleName}</h4>
                              <p className="text-[10px] sm:text-xs text-gray-600">{role.personName}</p>
                            </div>
                            <div className="flex gap-2">
                              <Button variant="outline" size="sm" onClick={() => { setCurrentRole(role); setIsEditingRole(true); }} className="h-8 w-8 p-0">
                                <Edit className="h-3 w-3" />
                              </Button>
                              <Button variant="destructive" size="sm" onClick={() => handleDeleteRole(role.id)} className="h-8 w-8 p-0">
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </CardContent>
            </Card>
          </TabsContent>
          
          {/* Other tabs simplified for space, keeping core logic */}
          <TabsContent value="events">
            <Card>
              <CardHeader>
                <CardTitle className="text-lg sm:text-xl">Events</CardTitle>
                <CardDescription className="text-xs sm:text-sm">Recent and upcoming events</CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-3">
                  {events.map(event => (
                    <div key={event.id} className="p-3 border rounded-lg flex justify-between items-center">
                      <div>
                        <h4 className="font-semibold text-xs sm:text-sm">{event.title}</h4>
                        <p className="text-[10px] text-gray-500">{new Date(event.eventDate).toLocaleDateString()}</p>
                      </div>
                      <Link href="/admin/events">
                        <Button variant="ghost" size="sm" className="h-8 w-8 p-0"><Edit className="h-3 w-3" /></Button>
                      </Link>
                    </div>
                  ))}
                  <Link href="/admin/events" className="block mt-4">
                    <Button variant="outline" className="w-full text-xs h-9">Manage All Events</Button>
                  </Link>
                </div>
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="logs">
            <Card>
              <CardHeader>
                <CardTitle className="text-lg sm:text-xl">Admin Audit Logs</CardTitle>
                <CardDescription className="text-xs sm:text-sm">History of administrative actions</CardDescription>
              </CardHeader>
              <CardContent>
                <div className="space-y-4">
                  {auditLogs.length === 0 ? (
                    <p className="text-center py-8 text-gray-500 text-sm">No logs found.</p>
                  ) : (
                    <div className="space-y-3">
                      {auditLogs.map((log) => (
                        <div key={log.id} className="p-3 border rounded-lg bg-white shadow-sm">
                          <div className="flex justify-between items-start mb-1">
                            <Badge variant="outline" className="text-[10px] uppercase font-black">
                              {log.action.replace("_", " ")}
                            </Badge>
                            <span className="text-[10px] text-gray-400">
                              {log.timestamp?.toDate ? log.timestamp.toDate().toLocaleString() : "Recently"}
                            </span>
                          </div>
                          <p className="text-xs font-medium text-gray-900 mb-1">{log.details}</p>
                          <p className="text-[10px] text-gray-500">By: {log.adminEmail}</p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>

        {/* Dialogs for adding/editing roles - simplified for mobile */}
        <Dialog open={isAddingRole} onOpenChange={setIsAddingRole}>
          <DialogContent className="w-[95vw] max-w-md p-4 sm:p-6">
            <DialogHeader><DialogTitle>Add Ministry Role</DialogTitle></DialogHeader>
            <form onSubmit={handleAddRole} className="space-y-3">
              <div className="space-y-1">
                <Label className="text-xs">Role Name</Label>
                <Input name="role_name" required className="h-9 text-sm" />
              </div>
              <div className="space-y-1">
                <Label className="text-xs">Person Name</Label>
                <Input name="person_name" required className="h-9 text-sm" />
              </div>
              <div className="space-y-1">
                <Label className="text-xs">Email</Label>
                <Input name="person_email" type="email" className="h-9 text-sm" />
              </div>
              <div className="space-y-1">
                <Label className="text-xs">Bio</Label>
                <Textarea name="bio" className="text-sm" />
              </div>
              <Button type="submit" className="w-full h-10 mt-2">Add Role</Button>
            </form>
          </DialogContent>
        </Dialog>

        <Dialog open={isEditingRole} onOpenChange={setIsEditingRole}>
          <DialogContent className="w-[95vw] max-w-md p-4 sm:p-6">
            <DialogHeader><DialogTitle>Edit Role</DialogTitle></DialogHeader>
            {currentRole && (
              <form onSubmit={handleEditRole} className="space-y-3">
                <div className="space-y-1">
                  <Label className="text-xs">Role Name</Label>
                  <Input name="role_name" defaultValue={currentRole.roleName} required className="h-9 text-sm" />
                </div>
                <div className="space-y-1">
                  <Label className="text-xs">Person Name</Label>
                  <Input name="person_name" defaultValue={currentRole.personName} required className="h-9 text-sm" />
                </div>
                <Button type="submit" className="w-full h-10 mt-2">Update Role</Button>
              </form>
            )}
          </DialogContent>
        </Dialog>
      </div>
  )
}
