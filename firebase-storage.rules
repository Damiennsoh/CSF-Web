rules_version = '2';
service firebase.storage {
  // permit uploads (write) only for authenticated users and
  // allow public read for any file in the `uploads/` folder.
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // optionally tighten rules for other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
